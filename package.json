{
  "name": "valle-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de Discord con casino virtual (moneda solo del bot, sin dinero real), torneos, moderación, voz temporal y roles.",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "node dist/deploy-commands.js",
    "deploy:dev": "tsx src/deploy-commands.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "discord.js": "^14.19.0",
    "dotenv": "^16.4.5",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
