{
  "name": "valle-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de Discord con granja, pesca, mercado, roles y registros configurables.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-activity.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy": "node dist/deploy-commands.js",
    "deploy:dev": "tsx src/deploy-commands.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "build:activity": "node scripts/build-activity.mjs",
    "balance": "tsx scripts/balance-report.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.1.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
