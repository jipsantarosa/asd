# Token del bot (Discord Developer Portal > Bot > Reset Token). Nunca lo subas a git.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
# Opcional: si lo dejás vacío, el bot lo saca del token.
CLIENT_ID=
# Opcional: ID de un servidor de pruebas. Si está definido, los comandos se registran ahí al instante.
DEV_GUILD_ID=
# Ruta de la base de datos SQLite
DATABASE_PATH=./data/valle.db
# Archivo opcional con overrides globales del juego (precios, zonas, curvas...)
GAME_CONFIG_PATH=./game.config.json
# Prefijo por defecto para servidores nuevos
DEFAULT_PREFIX=!

# ── Actividad de granja (opcional) ──
# Client Secret de OAuth2 (Developer Portal → OAuth2). Si está vacío, la Actividad no se inicia.
CLIENT_SECRET=
# Puerto local del servidor de la Actividad (el túnel HTTPS apunta acá).
ACTIVITY_PORT=3000
# Opcional: IDs de los dueños del bot (pueden dar premium), separados por coma. El dueño de la app se detecta solo.
OWNER_IDS=
