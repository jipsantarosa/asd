# Token del bot (Discord Developer Portal > Bot > Reset Token). Nunca lo subas a git.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
# Opcional: si lo dejás vacío, el bot lo saca del token.
CLIENT_ID=
# Opcional: ID de un servidor de pruebas. Si está definido, los comandos se registran ahí al instante.
DEV_GUILD_ID=
# Ruta de la base de datos SQLite
DATABASE_PATH=./data/valle.db
# Prefijo por defecto para servidores nuevos
DEFAULT_PREFIX=!
# Opcional: IDs de los dueños del bot, separados por coma. Pueden configurar el casino (!casino),
# ajustar saldos (!balance add|remove|set), crear torneos y dar premium. El dueño de la app se detecta solo.
OWNER_IDS=

# --- actualizar.bat (actualizacion automatica, opcional) ---
# Repositorio y rama de donde se baja la version nueva. Cuando se fusione a main, cambiá la rama a main.
UPDATE_REPO=jipsantarosa/asd
UPDATE_BRANCH=claude/bot-besos-canales-temporales-qdksf6
# Si el repositorio es PRIVADO hace falta UNA de estas dos cosas:
#   - tener Git instalado (https://git-scm.com): la primera vez abre el navegador para iniciar sesion en GitHub; o
#   - un token de GitHub de solo lectura (Settings > Developer settings > Fine-grained tokens > Contents: Read-only).
# El token va SOLO aca: nunca lo pegues en un chat ni lo subas a git.
GITHUB_TOKEN=

# --- Estadísticas de juegos (opcional) ---
# !uservalo Nombre#TAG: clave gratis de la API de HenrikDev (https://docs.henrikdev.xyz, se pide en su Discord).
HENRIK_API_KEY=
# !cs2 <perfil de Steam>: clave gratis de Steam (https://steamcommunity.com/dev/apikey).
STEAM_API_KEY=
# Formato del enlace a CSRep.gg ({steamid} = SteamID64). Cambialo solo si la página cambia sus enlaces.
CSREP_PROFILE_URL=https://csrep.gg/player/{steamid}
