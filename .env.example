# Token del bot (Discord Developer Portal > Bot > Reset Token). Nunca lo subas a git.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
# Opcional: si lo dejás vacío, el bot lo saca del token.
CLIENT_ID=
# Opcional: ID de un servidor de pruebas. Si está definido, los comandos se registran ahí al instante.
DEV_GUILD_ID=
# Ruta de la base de datos SQLite
DATABASE_PATH=./data/valle.db
# Prefijo por defecto para servidores nuevos
DEFAULT_PREFIX=!
# Opcional: IDs de los dueños del bot, separados por coma. Pueden configurar el casino (!casino),
# ajustar saldos (!balance add|remove|set), crear torneos y dar premium. El dueño de la app se detecta solo.
OWNER_IDS=
